// Base process configuration

process {
    
    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: 'copy',
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    // Resource defaults
    cpus = 4
    memory = '8 GB'
    time = '2h'

    // Process-specific configurations
    
    withName: 'STAR_INDEX' {
        cpus = 8
        memory = '30 GB'
        time = '4h'
    }

    withName: 'STAR_ALIGN' {
        cpus = 8
        memory = '30 GB'
        time = '6h'
    }

    withName: 'STAR_FUSION' {
        cpus = 4
        memory = '16 GB'
        time = '4h'
    }

    withName: 'FUSION_INSPECTOR' {
        cpus = 4
        memory = '16 GB'
        time = '4h'
    }

    withName: 'FASTQC' {
        cpus = 2
        memory = '4 GB'
        time = '1h'
    }

    withName: 'MULTIQC' {
        cpus = 2
        memory = '4 GB'
        time = '1h'
    }
}
