// Test profile
// Uses the STAR-Fusion tutorial mini dataset (symlinked under tests/data/).
// Triggers CTAT genome lib build from minigenome.fa + minigenome.gtf,
// then runs STAR-Fusion on rnaseq_1/2.fastq.gz.
//
// Run with:
//   nextflow run main.nf -profile test

params {
    // Input: paired FASTQs auto-detected via fromFilePairs
    input_fastq_dir     = "${projectDir}/tests/data"
    samplesheet         = null

    // Build CTAT genome lib from the mini genome
    genome_fa           = "${projectDir}/tests/data/minigenome.fa"
    gtf_file            = "${projectDir}/tests/data/minigenome.gtf"
    fusion_annot_lib    = "${projectDir}/tests/data/CTAT_HumanFusionLib.mini.dat.gz"
    ctat_genome_lib_dir = null

    // Output
    outdir              = "${projectDir}/results/test"

    // Relaxed thresholds for small test dataset
    min_junction_reads  = 1
    min_spanning_frags  = 0
}

// Reduced resources for test runs
process {
    withName: 'PREP_CTAT_GENOME_LIB' {
        cpus   = 4
        memory = '8 GB'
        time   = '1h'
    }

    withName: 'STAR_FUSION' {
        cpus   = 4
        memory = '16 GB'
        time   = '2h'
    }
}
