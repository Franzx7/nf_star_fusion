// Test profile configuration
// Uses mini genome and example FASTQ reads from the STAR-Fusion tutorial dataset.
// All input files are symlinked from tests/data/ -> STAR_fusion/data/ -> scratch.

params {
    // Test samplesheet
    samplesheet             = "${projectDir}/tests/samplesheet.test.csv"

    // Mini genome for STAR index construction
    genome_fa               = "${projectDir}/tests/data/minigenome.fa"
    gtf_file                = "${projectDir}/tests/data/minigenome.gtf"

    // CTAT fusion library (mini, for testing)
    // Note: STAR-Fusion requires an extracted genome lib directory.
    // Run prep_genome_lib.pl on minigenome.fa + minigenome.gtf first,
    // or point ctat_genome_lib_dir to a pre-built directory.
    ctat_genome_lib_dir     = "${projectDir}/tests/data"

    // Output
    outdir                  = "${projectDir}/results/test"

    // Reduce resource usage for testing
    skip_multiqc            = false
    skip_fastqc             = false

    // STAR-Fusion thresholds (relaxed for small test dataset)
    min_junction_reads      = 1
    min_spanning_frags      = 0
}

// Reduce resource requirements for test runs
process {
    withName: 'STAR_INDEX' {
        cpus   = 4
        memory = '8 GB'
        time   = '1h'
    }

    withName: 'STAR_ALIGN' {
        cpus   = 4
        memory = '8 GB'
        time   = '1h'
    }

    withName: 'STAR_FUSION' {
        cpus   = 2
        memory = '4 GB'
        time   = '30m'
    }

    withName: 'FUSION_INSPECTOR' {
        cpus   = 2
        memory = '4 GB'
        time   = '30m'
    }

    withName: 'FASTQC' {
        cpus   = 1
        memory = '2 GB'
        time   = '15m'
    }

    withName: 'MULTIQC' {
        cpus   = 1
        memory = '2 GB'
        time   = '15m'
    }
}
