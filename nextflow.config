// Main Nextflow Configuration for STAR-Fusion Pipeline
manifest {
    name            = 'STAR-Fusion Pipeline'
    author          = 'Franz AKE'
    homePage        = 'https://github.com/Franzx7'
    description     = 'Nextflow pipeline for detecting fusion transcripts from RNA-seq data'
    mainScript      = 'workflows/main.nf'
    nextflowVersion = '>=21.10.0'
    version         = '1.0.0'
}

// Global default params
params {
    // Input data
    input_fastq_dir     = null
    samplesheet         = null

    // CTAT genome library (pre-built or custom build)
    ctat_genome_lib_dir = null
    genome_fa           = null
    gtf_file            = null
    fusion_annot_lib    = null

    // Output
    outdir              = './results'

    // STAR-Fusion parameters
    min_junction_reads  = 1
    min_spanning_frags  = 0

    // Help message
    help                = false
}

// Include base config
includeConfig 'conf/base.config'

// Execution profiles
profiles {
    docker {
        docker.enabled = true
        docker.userEmulation = true
        process.container = 'star-fusion:latest'
    }

    singularity {
        singularity.enabled = true
        process.container = 'star-fusion:latest'
    }

    local {
        executor.name = 'local'
        executor.cpus = 8
        executor.memory = '32 GB'
    }

    slurm {
        executor.name = 'slurm'
        executor.queueSize = 10
        submitRateLimit = '10 sec'
        queue = 'normal'
    }

    sge {
        executor.name = 'sge'
        executor.queueSize = 10
        penv = 'smp'
    }

    test {
        includeConfig 'conf/test.config'
    }
}

// Default resource limits
process {
    errorStrategy = { task.exitStatus in 137..140 ? 'retry' : 'terminate' }
    maxRetries = 1

    withLabel:process_high {
        cpus   = 16
        memory = '60 GB'
        time   = '12h'
    }

    withLabel:process_medium {
        cpus   = 8
        memory = '30 GB'
        time   = '6h'
    }

    withLabel:process_low {
        cpus   = 4
        memory = '8 GB'
        time   = '2h'
    }
}

// Capture exit codes from upstream processes when piping
process.shell = ['/bin/bash', '-euo', 'pipefail']

// Timeline, report and trace outputs
timeline {
    enabled = true
    file    = "${params.outdir}/execution_timeline.html"
}

report {
    enabled = true
    file    = "${params.outdir}/execution_report.html"
}

trace {
    enabled = true
    overwrite = true
    file    = "${params.outdir}/execution_trace.txt"
}

dag {
    enabled = true
    file    = "${params.outdir}/pipeline_dag.html"
}
